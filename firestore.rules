// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: usuarios
// Fields:
//   - login: string (required)
//   - name: string (required)
//   - role: string (admin/seller)
//   - createdAt: timestamp
//
// Collection: produtos
// Fields:
//   - name: string (required)
//   - price: number (required)
//   - stock: number (required)
//   - cost: number
//   - brand: string
//   - category: string
//
// Collection: vendas
// Fields:
//   - items: list (required)
//   - total: number (required)
//   - date: timestamp/string (required)
//   - seller_id: string
//   - customer_id: string
//
// Collection: gastos
// Fields:
//   - description: string (required)
//   - value: number (required)
//   - date: string (required)
//   - category: string
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // 0. Global Safety Net
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Global Helpers
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Role detection
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ["michellerosario.n@gmail.com", "fm2099928@gmail.com", "natanaelrafael692@gmail.com", "suporte@sistema.com"] ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isSeller() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role in ['vendedor', 'seller']
      );
    }

    // ===============================================================
    // Entity Validators
    // ===============================================================
    
    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.stock is number;
    }

    function isValidCustomer(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200;
    }

    function isValidSale(data) {
      return data.items is list && data.items.size() > 0 &&
             data.final_price is number &&
             data.date is string;
    }

    function isValidPurchase(data) {
      return data.supplier_name is string && data.supplier_name.size() > 0 &&
             data.items is list &&
             data.status in ['pending', 'received', 'cancelled'] &&
             data.total_value is number;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================
    
    match /usuarios/{userId} {
      allow list: if isSignedIn() && (isAdmin() || resource.data.email == request.auth.token.email);
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn(); // Allow profile creation on first login
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /produtos/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /clientes/{customerId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /vendas/{saleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /gastos/{expenseId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /compras/{purchaseId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /configuracoes/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /estoque_movimentacoes/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /fornecedores/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /vendedores/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /anuncios/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
